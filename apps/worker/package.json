{
  "name": "@cslp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --env-file-if-exists=../api/.env --env-file-if-exists=.env --watch-path=dist --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"worker: processors are tested in @cslp/server-core\""
  },
  "dependencies": {
    "@cslp/server-core": "workspace:*",
    "@nestjs/common": "12.4.1",
    "@nestjs/core": "12.4.1",
    "@nestjs/mongoose": "12.0.1",
    "bullmq": "6.7.2",
    "mongoose": "9.12.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cslp/config": "workspace:*",
    "pino-pretty": "13.2.0"
  }
}
