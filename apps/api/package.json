{
  "name": "@cslp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch-path=dist --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:emit": "pnpm build && node dist/scripts/emit-openapi.js ../../docs/openapi.json",
    "seed": "pnpm build && node --env-file-if-exists=.env dist/scripts/seed.js",
    "reset-admin": "pnpm build && node --env-file-if-exists=.env dist/scripts/reset-admin.js"
  },
  "dependencies": {
    "@cslp/server-core": "workspace:*",
    "@cslp/shared-types": "workspace:*",
    "@cslp/validation": "workspace:*",
    "@nestjs/common": "12.4.1",
    "@nestjs/core": "12.4.1",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-express": "12.4.1",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongoose": "9.12.0",
    "multer": "2.0.2",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.4.0",
    "otpauth": "9.6.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cslp/config": "workspace:*",
    "@nestjs/testing": "12.4.1",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
