NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
MONGODB_URI=mongodb://localhost:27018/cslp?directConnection=true
REDIS_URL=redis://localhost:6380
# 32+ random chars: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# 32 random bytes, base64: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
ADMIN_APP_URL=http://localhost:3001
# Where students land from email links (defaults to ADMIN_APP_URL, which hosts /verify-email and /reset-password)
# STUDENT_APP_URL=http://localhost:3000
# Optional: restrict student self-registration to these email domains (comma-separated)
# STUDENT_EMAIL_DOMAINS=yabatech.edu.ng
# Email: SMTP when SMTP_HOST is set, otherwise messages are logged. Local: Mailpit (UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=CSLP <no-reply@cslp.local>
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
COOKIE_SECURE=false
# true = Super/Institution Administrators must use an authenticator app. Default false: optional (Settings).
# MFA_REQUIRED=false
# Seed (pnpm seed)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
# Object storage (local: SeaweedFS from infrastructure/docker-compose.yml)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=cslp-dev
S3_ACCESS_KEY_ID=cslp
S3_SECRET_ACCESS_KEY=cslp-dev-password
S3_FORCE_PATH_STYLE=true
# Optional malware scanning (docker compose --profile security up -d clamav)
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# AI providers (optional; without a key, outlines use layout detection and embeddings are skipped)
# OPENAI_API_KEY=
# AI_MODEL_OUTLINE_EXTRACT=<model id for outline extraction>
# AI_TEXT_PROVIDER=openai              # openai | fake (development placeholders) | none
# AI_MODEL_NOTES=<model id for notes and revision packs>
# AI_EMBEDDINGS_PROVIDER=openai        # openai | fake | none
# AI_EMBEDDINGS_MODEL=<embedding model id>
# AI_EMBEDDINGS_DIMENSIONS=1536
