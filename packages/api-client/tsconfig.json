{
  "extends": "@cslp/config/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
